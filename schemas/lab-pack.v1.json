{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "status", "question", "exercises", "profile", "probeCatalog", "phases", "controls", "remedies", "competingExplanations", "bundle", "guide", "stillToBuild"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "status": { "enum": ["working", "planned"] },
    "question": { "type": "string", "minLength": 10, "maxLength": 400 },
    "exercises": { "type": "string", "minLength": 3, "maxLength": 200 },
    "profile": { "const": "local-lab" },
    "probeCatalog": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["source", "sha256"], "properties": {
          "source": { "enum": ["native-lab", "pooling-evidence", "index-evidence", "connectivity-evidence", "permissions-evidence", "pool-exhaustion-evidence"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
      ]
    },
    "phases": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" } },
    "controls": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["phase", "purpose"], "properties": {
      "phase": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
      "purpose": { "type": "string", "minLength": 10, "maxLength": 300 } } } },
    "remedies": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" } },
    "competingExplanations": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 5, "maxLength": 200 } },
    "bundle": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["scenario", "toolVersions"], "properties": {
          "scenario": { "enum": ["schema-resolution", "pooling-session", "slow-query-index", "tls-trust", "table-privilege", "connection-leak"] },
          "toolVersions": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^0\\.1\\.0-[a-z0-9-]+$" } } } }
      ]
    },
    "guide": { "oneOf": [ { "type": "null" }, { "type": "string", "pattern": "^docs/[a-z0-9-]+\\.md$" } ] },
    "stillToBuild": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 5, "maxLength": 200 } }
  }
}
