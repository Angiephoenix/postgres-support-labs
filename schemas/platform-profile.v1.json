{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "scope", "sources", "facts", "customerQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "planetscale-postgres" },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "scope": { "const": "Documented platform facts only. Nothing in this profile was tested against PlanetScale or a customer environment." },
    "sources": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "url", "markdownUrl", "retrievedAt", "markdownSha256", "htmlSha256"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "url": { "type": "string", "pattern": "^https://planetscale\\.com/docs/[a-z0-9/-]+$" },
        "markdownUrl": { "type": "string", "pattern": "^https://planetscale\\.com/docs/[a-z0-9/-]+\\.md$" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "markdownSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "htmlSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "facts": { "type": "array", "minItems": 1, "maxItems": 60, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "topic", "classification", "statement", "sourceId", "passage", "passageSha256"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,60}$" },
        "topic": { "enum": ["pooling", "ssl", "connection-string"] },
        "classification": { "const": "DOCUMENTED_BEHAVIOR" },
        "statement": { "type": "string", "minLength": 10, "maxLength": 300 },
        "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
        "passage": { "type": "string", "minLength": 10, "maxLength": 600 },
        "passageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "customerQuestions": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "topic", "question", "facts"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,60}$" },
        "topic": { "enum": ["pooling", "ssl", "connection-string"] },
        "question": { "type": "string", "minLength": 10, "maxLength": 300 },
        "facts": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,60}$" } } } } }
  }
}
