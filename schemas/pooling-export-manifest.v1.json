{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PgBouncer session support bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenario",
    "toolVersion",
    "profile",
    "runId",
    "generatedAt",
    "mode",
    "comparisonHash",
    "reviewHead",
    "sourceManifestHash",
    "remedy",
    "redactionStatus",
    "communicationApproval",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenario": {
      "const": "pooling-session"
    },
    "toolVersion": {
      "enum": [
        "0.1.0-pooling-bundle1",
        "0.1.0-pooling-bundle2",
        "0.1.0-pooling-bundle3"
      ]
    },
    "profile": {
      "const": "local-lab"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "reviewed",
        "gaps"
      ]
    },
    "comparisonHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceManifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "remedy": {
      "enum": [
        null,
        "transaction-contained",
        "protocol-prepared"
      ]
    },
    "redactionStatus": {
      "const": "recognized-patterns-checked"
    },
    "communicationApproval": {
      "const": "PENDING"
    },
    "files": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "enum": [
              "case-summary.md",
              "comparison.json",
              "customer-reply.md",
              "engineering-escalation.md",
              "evidence-gap-report.md",
              "evidence.jsonl",
              "findings.json",
              "hypotheses.json",
              "probe-plan.json",
              "reproduction.md",
              "resolution-validation.md",
              "runbook-candidate.md",
              "sources/pooling-manifest.json",
              "sources/pooling-plan.json",
              "sources/pooling-probes.json",
              "sources/pooling-reviews.jsonl",
              "sources/pooling-run.json",
              "support-bundle.html",
              "timeline.json",
              "validation.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "number"
          }
        }
      }
    }
  }
}
