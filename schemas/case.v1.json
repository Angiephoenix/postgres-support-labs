{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "profile",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "profile": {
      "const": "fixture"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "branchFingerprint",
        "roleFingerprint",
        "connectionMode",
        "identityMethod"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "branchFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "roleFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "connectionMode": {
          "enum": [
            "direct",
            "pooled",
            "unknown"
          ]
        },
        "identityMethod": {
          "const": "fixture-definition"
        }
      }
    }
  }
}
